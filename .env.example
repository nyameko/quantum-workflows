# Never commit a populated copy of this file.
# Direct IBM Quantum Compute Service execution normally uses a locally saved
# Qiskit account. These variables provide an ephemeral alternative.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_INSTANCE=

# QRMI values are normally injected by the Slurm SPANK plugin.
QRMI_JOB_QPU_RESOURCES=ibm_resource_name
QRMI_JOB_QPU_TYPES=ibm-quantum-compute-service
